    {
      "id": "flow2-text",
      "type": "text",
      "x": 1510,
      "y": 368,
      "width": 400,
      "height": 78,
      "text": "1. Gate Camera streams frames via WebSocket\n2. Node proxy → Python FastAPI /recognize\n3. ArcFace matches face → student ID\n4. Record saved to MongoDB\n5. Real-time event → Dashboard via Socket.IO\n6. If absent: Nodemailer sends email to parents",
      "fontSize": 11,
      "fontFamily": 1,
      "textAlign": "left",
